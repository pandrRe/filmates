{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-explicit-any": "error",
    "no-non-null-assertion": "error"
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "convex/_generated", "dist"]
}
